# Copy to backend/.env for local runs (docker compose sets most of these for you).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fitpro:fitpro@localhost:5432/fitpro
# For a zero-setup run without PostgreSQL:
# DATABASE_URL=sqlite:///./fitpro.db
# AUTO_CREATE_TABLES=true

# --- Auth: "local" (email/password, Argon2 + JWT) or "supabase" (Supabase Auth issues tokens)
AUTH_MODE=local
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<project JWT secret>
# SUPABASE_SERVICE_KEY=<service role key, server only>

# --- AI: leave empty to use the built-in rule-based parser
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Storage for uploaded workout plans: "local" or "supabase"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# SUPABASE_STORAGE_BUCKET=workout-plans

CORS_ORIGINS='["http://localhost:3000"]'
FRONTEND_URL=http://localhost:3000
CHAT_RATE_LIMIT_PER_MINUTE=30
